 	refcount_t			refcount;
@@ -759,6 +771,9 @@ struct minlat_tgid_ctx {
 	atomic_t			nr_tasks;	/* tasks in this group */
 	atomic_t			nr_on_llc;	/* tasks on preferred LLC */
 	raw_spinlock_t			lock;
+
+	/* Per-LLC thread distribution tracking */
+	struct minlat_llc_count		llcs[MINLAT_TGID_MAX_LLCS];
 };
 
