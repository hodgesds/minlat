From 368e308e1a4ce62b67b5a17afeb20979b4dfbe28 Mon Sep 17 00:00:00 2001
From: Daniel Hodges <hodgesd@meta.com>
Date: Tue, 31 Mar 2026 06:11:51 -0700
Subject: [PATCH 3/4] sched/debug: Add MINLAT debugfs tunables and statistics

Add debugfs interface for runtime tuning and observability of the
MINLAT scheduling class.

Debugfs tunables (/sys/kernel/debug/sched/minlat/):
 - latency_ns:              target scheduling latency (default 1.5ms)
 - min_granularity_ns:      minimum timeslice (default 500us)
 - cache_hot_ns:            cache-hot threshold for migration (500us)
 - wakeup_preempt_thresh_ns: non-sync wakeup preemption threshold (1ms)
 - wake_affine:             enable/disable wake-affine heuristic
 - fork_imbalance_pct:      cross-LLC fork threshold (25%)
 - fork_numa_imbalance_pct: cross-NUMA fork threshold (50%)
 - numa_imbalance_min:      min imbalance for NUMA migration (2)
 - numa_saturated_pct:      NUMA saturation threshold (75%)
 - migration_cooldown_ns:   min time between migrations (4ms)
 - interactive_big_prefer:  prefer big cores for interactive tasks
 - compute_big_prefer:      prefer big cores for compute tasks
 - llc_stickiness:          min runs before cross-LLC pull (1)
 - enabled:                 runtime toggle to switch all tasks
                            between MINLAT and CFS

Sched debug statistics (via /proc/schedstat, /sys/kernel/debug/sched):
 - Per-CPU minlat_rq dump: nr_running, nr_delayed, min_vruntime,
   left_vruntime, load_weight, util_avg, load_avg, util_est,
   overloaded status, and bandwidth throttle count
---
 kernel/sched/debug.c | 96 ++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 96 insertions(+)

diff --git a/kernel/sched/debug.c b/kernel/sched/debug.c
index b24f40f05019..2257e203eed2 100644
--- a/kernel/sched/debug.c
+++ b/kernel/sched/debug.c
@@ -625,20 +625,60 @@ static __init int sched_init_debug(void)
 	debugfs_create_u32("hot_threshold_ms", 0644, numa, &sysctl_numa_balancing_hot_threshold);
 #endif /* CONFIG_NUMA_BALANCING */
 
 	debugfs_create_file("debug", 0444, debugfs_sched, NULL, &sched_debug_fops);
 
 	debugfs_fair_server_init();
 #ifdef CONFIG_SCHED_CLASS_EXT
 	debugfs_ext_server_init();
 #endif
 
+#ifdef CONFIG_SCHED_CLASS_MINLAT
+	{
+		struct dentry *d_minlat;
+
+		d_minlat = debugfs_create_dir("minlat", debugfs_sched);
+		debugfs_create_u32("latency_ns", 0644, d_minlat,
+				   &minlat_latency_ns);
+		debugfs_create_u32("min_granularity_ns", 0644, d_minlat,
+				   &minlat_min_granularity_ns);
+		debugfs_create_u32("cache_hot_ns", 0644, d_minlat,
+				   &minlat_cache_hot_ns);
+		debugfs_create_u32("numa_imbalance_min", 0644, d_minlat,
+				   &minlat_numa_imbalance_min);
+		debugfs_create_u32("migration_cooldown_ns", 0644, d_minlat,
+				   &minlat_migration_cooldown_ns);
+		debugfs_create_u32("numa_saturated_pct", 0644, d_minlat,
+				   &minlat_numa_saturated_pct);
+		debugfs_create_u32("wake_affine", 0644, d_minlat,
+				   &minlat_wake_affine);
+		debugfs_create_u32("wakeup_preempt_thresh_ns", 0644, d_minlat,
+				   &minlat_wakeup_preempt_thresh_ns);
+		debugfs_create_u32("fork_imbalance_pct", 0644, d_minlat,
+				   &minlat_fork_imbalance_pct);
+		debugfs_create_u32("fork_numa_imbalance_pct", 0644, d_minlat,
+				   &minlat_fork_numa_imbalance_pct);
+		debugfs_create_u32("interactive_big_prefer", 0644, d_minlat,
+				   &minlat_interactive_big_prefer);
+		debugfs_create_u32("compute_big_prefer", 0644, d_minlat,
+				   &minlat_compute_big_prefer);
+		debugfs_create_u32("llc_stickiness", 0644, d_minlat,
+				   &minlat_llc_stickiness);
+
+		{
+			extern const struct file_operations minlat_enabled_fops;
+			debugfs_create_file("enabled", 0644, d_minlat,
+					    NULL, &minlat_enabled_fops);
+		}
+	}
+#endif
+
 	return 0;
 }
 late_initcall(sched_init_debug);
 
 static cpumask_var_t		sd_sysctl_cpus;
 
 static int sd_flags_show(struct seq_file *m, void *v)
 {
 	unsigned long flags = *(unsigned int *)m->private;
 	int idx;
@@ -892,20 +932,73 @@ static void print_rq(struct seq_file *m, struct rq *rq, int rq_cpu)
 	rcu_read_lock();
 	for_each_process_thread(g, p) {
 		if (task_cpu(p) != rq_cpu)
 			continue;
 
 		print_task(m, rq, p);
 	}
 	rcu_read_unlock();
 }
 
+#ifdef CONFIG_SCHED_CLASS_MINLAT
+static void print_minlat_rq(struct seq_file *m, int cpu)
+{
+	struct rq *rq = cpu_rq(cpu);
+	struct minlat_rq *minlat_rq = &rq->minlat;
+	struct rb_node *leftmost;
+	s64 left_vruntime = -1;
+	unsigned long flags;
+
+	SEQ_printf(m, "\n");
+	SEQ_printf(m, "minlat_rq[%d]:\n", cpu);
+
+	raw_spin_rq_lock_irqsave(rq, flags);
+	leftmost = rb_first_cached(&minlat_rq->tasks_timeline);
+	if (leftmost) {
+		struct sched_minlat_entity *me;
+
+		me = rb_entry(leftmost, struct sched_minlat_entity, run_node);
+		left_vruntime = me->vruntime;
+	}
+	raw_spin_rq_unlock_irqrestore(rq, flags);
+
+#define P(x) \
+	SEQ_printf(m, "  .%-30s: %d\n", #x, minlat_rq->x)
+#define Pn(x) \
+	SEQ_printf(m, "  .%-30s: %Ld.%06ld\n", #x, SPLIT_NS(minlat_rq->x))
+#define Pl(x) \
+	SEQ_printf(m, "  .%-30s: %lu\n", #x, minlat_rq->x)
+
+	P(nr_running);
+	P(nr_delayed);
+	Pn(min_vruntime);
+	SEQ_printf(m, "  .%-30s: %Ld.%06ld\n", "left_vruntime",
+		   SPLIT_NS(left_vruntime));
+	Pl(load_weight);
+	SEQ_printf(m, "  .%-30s: %lu\n", "util_avg",
+		   minlat_rq->avg.util_avg);
+	SEQ_printf(m, "  .%-30s: %lu\n", "load_avg",
+		   minlat_rq->avg.load_avg);
+	SEQ_printf(m, "  .%-30s: %u\n", "util_est",
+		   minlat_rq->util_est);
+	SEQ_printf(m, "  .%-30s: %d\n", "overloaded",
+		   minlat_rq->overloaded);
+#ifdef CONFIG_CFS_BANDWIDTH
+	P(nr_bw_throttled);
+#endif
+
+#undef P
+#undef Pn
+#undef Pl
+}
+#endif /* CONFIG_SCHED_CLASS_MINLAT */
+
 void print_cfs_rq(struct seq_file *m, int cpu, struct cfs_rq *cfs_rq)
 {
 	s64 left_vruntime = -1, zero_vruntime, right_vruntime = -1, left_deadline = -1, spread;
 	struct sched_entity *last, *first, *root;
 	struct rq *rq = cpu_rq(cpu);
 	unsigned long flags;
 
 #ifdef CONFIG_FAIR_GROUP_SCHED
 	SEQ_printf(m, "\n");
 	SEQ_printf_task_group_path(m, cfs_rq->tg, "cfs_rq[%d]:%s\n", cpu);
@@ -1068,20 +1161,23 @@ do {									\
 #define P(n) SEQ_printf(m, "  .%-30s: %d\n", #n, schedstat_val(rq->n));
 	if (schedstat_enabled()) {
 		P(yld_count);
 		P(sched_count);
 		P(sched_goidle);
 		P(ttwu_count);
 		P(ttwu_local);
 	}
 #undef P
 
+#ifdef CONFIG_SCHED_CLASS_MINLAT
+	print_minlat_rq(m, cpu);
+#endif
 	print_cfs_stats(m, cpu);
 	print_rt_stats(m, cpu);
 	print_dl_stats(m, cpu);
 
 	print_rq(m, rq, cpu);
 	SEQ_printf(m, "\n");
 }
 
 static const char *sched_tunable_scaling_names[] = {
 	"none",
